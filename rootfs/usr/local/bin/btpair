#!/bin/bash
# Search for Bluetooth devices, pick one by number, then pair, trust and connect it
T=${1:-12}
bton >/dev/null || { echo "No Bluetooth adapter found. Is the dongle plugged in?"; exit 1; }
echo "Put your device into pairing mode now."
echo "Searching for $T seconds..."
bluetoothctl --timeout "$T" scan on >/dev/null 2>&1
mapfile -t DEVS < <(bluetoothctl devices | awk '{mac=$2; $1=""; $2=""; sub(/^  /,""); if ($0 != "" && $0 !~ /^([0-9A-F]{2}-){5}[0-9A-F]{2}$/) print mac " " $0}')
if [ ${#DEVS[@]} -eq 0 ]; then echo "No devices found. Try again: btpair 20"; exit 1; fi
for i in "${!DEVS[@]}"; do
  printf "%2d) %s\n" $((i + 1)) "${DEVS[$i]#* }"
done
read -rp "Number (Enter = cancel): " N
[ -n "$N" ] || exit 0
[[ "$N" =~ ^[0-9]+$ ]] && [ "$N" -ge 1 ] && [ "$N" -le ${#DEVS[@]} ] || { echo "Invalid number."; exit 1; }
MAC=${DEVS[$((N - 1))]%% *}
NAME=${DEVS[$((N - 1))]#* }
echo "Pairing with $NAME ($MAC)..."
echo "If a code is shown, type it on the device and press Enter there."
{
  echo "agent KeyboardDisplay"; echo "default-agent"
  echo "pair $MAC"; sleep 3; echo "yes"
  for i in $(seq 1 30); do
    sleep 1
    bluetoothctl info "$MAC" 2>/dev/null | grep -q "Paired: yes" && break
  done
  echo "trust $MAC"; echo "connect $MAC"; sleep 5; echo "quit"
} | bluetoothctl 2>/dev/null | sed -u 's/\x1b\[[0-9;]*m//g' | grep --line-buffered -E "Passkey|PIN code|Pairing successful|Failed|not available"
if bluetoothctl info "$MAC" | grep -q "Paired: yes"; then
  if bluetoothctl info "$MAC" | grep -q "Connected: yes"; then
    echo "Done: $NAME is paired and connected."
  else
    echo "Paired. $NAME will connect automatically when it is switched on."
  fi
else
  echo "Pairing failed. Put the device into pairing mode and try again."
  exit 1
fi

#!/bin/bash
# Console font for the PicoCalc screen
#   font          list the fonts, try one, keep it or go back
#   font NAME     switch to NAME and save it
#   font list     only list
. /usr/local/lib/picocalc/fonts.sh
PCONF=/etc/picocalc.conf
if [ -t 1 ]; then R=$'\e[0m'; YE=$'\e[1;33m'; GR=$'\e[1;32m'; RD=$'\e[1;31m'; else R=; YE=; GR=; RD=; fi
save() {
  touch "$PCONF"
  if grep -q '^CONSOLE_FONT=' "$PCONF"; then sed -i "s/^CONSOLE_FONT=.*/CONSOLE_FONT=$1/" "$PCONF"; else echo "CONSOLE_FONT=$1" >> "$PCONF"; fi
}
dims() {   # columns x rows on the 320x320 screen
  [ "$1" = default ] && { echo "40x20 built-in"; return; }
  local s w h
  s=$(cat /sys/class/graphics/fb0/virtual_size 2>/dev/null || echo 320,320)
  read -r w h < <(python3 -c '
import gzip, struct, sys
d = gzip.open(sys.argv[1]).read(32)
if d[:4] == b"\x72\xb5\x4a\x86": h, w = struct.unpack("<II", d[24:32])
else: h, w = d[3], 8
print(w, h)' "$FONTDIR/$(font_file "$1").psf.gz" 2>/dev/null)
  [ -n "$w" ] && echo "$(( ${s%,*} / w ))x$(( ${s#*,} / h ))" || echo "?"
}
list() {
  local cur i=1 n; cur=$(font_get); cur=${cur:-default}
  for n in $FONTS; do
    printf '%s%3d)%s %-15s %s' "$YE" $i "$R" "$n" "$(dims "$n")"
    [ "$n" = "$cur" ] && printf '  %s<- now%s' "$GR" "$R"
    echo; i=$((i + 1))
  done
}
case "$1" in
  list) list; exit 0 ;;
  -h|--help) sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  "") ;;
  *)
    [ -n "$(font_file "$1")" ] || { echo "Unknown font: $1"; list; exit 1; }
    font_apply "$1" && save "$1" && echo "${GR}Font: $1 (saved)${R}"
    exit 0 ;;
esac
OLD=$(font_get); OLD=${OLD:-default}
list
echo "  ${YE}s)${R} skip"
read -rp "Choice: " a
[[ "$a" =~ ^[0-9]+$ ]] || { echo "Nothing changed."; exit 0; }
NEW=$(echo $FONTS | cut -d' ' -f"$a")
[ -n "$NEW" ] || { echo "${RD}Invalid choice.${R}"; exit 1; }
font_apply "$NEW"
read -t 15 -rp "Keep this font? [y/n] (15 s, then back) " k
if [[ "$k" =~ ^[yY] ]]; then
  save "$NEW"; echo "${GR}Font: $NEW (saved)${R}"
else
  font_apply "$OLD"; echo "Back to: $OLD"
  [ "$OLD" = default ] && echo "(the exact built-in font returns after a restart)"
fi

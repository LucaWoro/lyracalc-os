#!/bin/bash
# Key repeat for the console now, pointer speed for X at its next start
. /usr/local/lib/picocalc/input.sh
kbdrate -s -d "$KEY_REPEAT_DELAY" -r "$KEY_REPEAT_RATE" >/dev/null 2>&1 || true
# libinput: flat profile, factor 1 + AccelSpeed; evdev: 1 / ConstantDeceleration
ACC=$(awk -v n="$MOUSE_SPEED" 'BEGIN { s = n / 5 - 1; if (s > 1) s = 1; printf "%.2f", s }')
DEC=$(awk -v n="$MOUSE_SPEED" 'BEGIN { printf "%.2f", 5 / n }')
cat > /etc/X11/xorg.conf.d/90-picocalc-input.conf << XEOF
# Generated by picocalc-input-apply, change with inputconfig
Section "InputClass"
    Identifier "PicoCalc pointer speed"
    MatchIsPointer "on"
    Option "AccelProfile" "flat"
    Option "AccelSpeed" "$ACC"
    Option "AccelerationProfile" "-1"
    Option "ConstantDeceleration" "$DEC"
EndSection
XEOF
# USB keyboard layout: X at its next start, console now
. /usr/local/lib/picocalc/conf.sh
L=$(pc_get USB_KEYBOARD_LAYOUT); V=$(pc_get USB_KEYBOARD_VARIANT)
K=/etc/X11/xorg.conf.d/91-usb-keyboard.conf
if [[ "$L" =~ ^[a-z]{2,3}$ ]] && [ "$L" != us ]; then
  cat > "$K" << XEOF
# Generated by picocalc-input-apply from USB_KEYBOARD_LAYOUT
Section "InputClass"
    Identifier "USB keyboard layout"
    MatchIsKeyboard "on"
    MatchUSBID "????:????"
    Option "XkbLayout" "$L"
    Option "XkbVariant" "$V"
EndSection
XEOF
else
  rm -f "$K"
fi
/usr/local/sbin/kbd-layout.sh

+}
+
+/* send len bytes of RGB565 pixels starting at src */
+static int write_mem(struct ili9488_par *par, const void *src, size_t len)
+{
+    const u16 *vmem16 = src;
     u8 *txbuf = par->txbuf.buf;
     size_t remain;
     size_t to_copy;
@@ -711,35 +747,29 @@ static int write_vmem(struct ili9488_par *par, size_t offset, size_t len)

+/* Status bar overlay: /dev/fb_overlay
+ * A program writes N full lines (N * 640 bytes, RGB565 like the framebuffer).
+ * The driver then always sends these lines to the top of the panel instead of
+ * the framebuffer content, so console text or X can never draw over them.
+ * The overlay disappears automatically when the device is closed (also when
+ * the program is killed). */
+#define OVL_MAX_ROWS 32
+
 
 struct ili9488_par;
 
@@ -97,6 +111,13 @@ struct ili9488_par {
 
     u32             dirty_lines_start;
     u32             dirty_lines_end;
+
+    /* status bar overlay */
+    struct miscdevice       ovl_misc;
+    struct mutex            ovl_lock;
+    u8                      *ovl_buf;
+    u32                     ovl_rows;
+    atomic_t                ovl_open;
 };
 
 #define gpio_put(d, v) gpiod_set_raw_value(d, v)
@@ -198,8 +219,7 @@ static int ili9488_init_display(struct ili9488_par *priv)
     write_reg(priv, 0xF7, 0xA9, 0x51, 0x2C, 0x82);  // Adjust Control 3

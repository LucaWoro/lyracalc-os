     fb_deferred_io_init(info);
@@ -1170,10 +1293,17 @@ static int ili9488_probe(struct spi_device *spi)
 
     spin_lock_init(&par->dirty_lock);
     init_completion(&par->complete);
+    mutex_init(&par->ovl_lock);
+    atomic_set(&par->ovl_open, 0);
+    par->ovl_rows = 0;
+    par->ovl_buf = devm_kzalloc(dev, OVL_MAX_ROWS * info->fix.line_length, GFP_KERNEL);
     ili9488_of_config(par);
     ili9488_hw_init(par);
 
     update_display(par, 0, par->fbinfo->var.yres - 1);
+    gpio_put(par->gpio.cs, 0);
+    write_reg(par, 0x29);   /* display on only now (screen is cleared): no snow */
+    gpio_put(par->gpio.cs, 1);
     /* framebuffer register */
     rc = register_framebuffer(info);
     if (rc < 0) {
@@ -1184,6 +1314,18 @@ static int ili9488_probe(struct spi_device *spi)
     event.info = info;
     fb_notifier_call_chain(0x0F, &event);
 
+    if (par->ovl_buf) {
+        par->ovl_misc.minor = MISC_DYNAMIC_MINOR;
+        par->ovl_misc.name = "fb_overlay";
+        par->ovl_misc.fops = &ovl_fops;
+        if (misc_register(&par->ovl_misc)) {
+            par->ovl_misc.fops = NULL;
+            dev_warn(dev, "could not register /dev/fb_overlay\n");
+        }
+        else
+            dev_info(dev, "status bar overlay: /dev/fb_overlay\n");
+    }
+
     printk("%zu KB buffer memory\n", par->txbuf.len >> 10);
     printk("%d KB video memory\n", info->fix.smem_len >> 10);
 
@@ -1199,6 +1341,8 @@ static void ili9488_remove(struct spi_device *spi)
     struct ili9488_par *par = spi_get_drvdata(spi);
 
     printk("%s\n", __func__);
+    if (par->ovl_misc.fops)
+        misc_deregister(&par->ovl_misc);
     fb_deferred_io_cleanup(par->fbinfo);
 
     unregister_framebuffer(par->fbinfo);

-        return fbtft_write_spi_wr(par, vmem16, len);
+        return fbtft_write_spi_wr(par, (void *)vmem16, len);
 
     tx_array_size = par->txbuf.len / 3;
 
     while (remain) {
         to_copy = min(tx_array_size, remain);
-        dev_dbg(par->fbinfo->device, "to_copy=%zu, remain=%zu\n",

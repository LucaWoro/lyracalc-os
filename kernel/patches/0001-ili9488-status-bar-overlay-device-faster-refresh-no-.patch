-            //txbuf[k++] = ((vmem16[i] & 0x001F) << 3) & 0xFF;
-            // txbuf[k++] = 255;
-            // txbuf[k++] = 0;
-            // txbuf[k++] = 0;
-        } 
-
-//        memcpy(txbuf, vmem16, to_copy * 2);
+        }
 
         /* send batch to device */
         fbtft_write_spi_wr(par, txbuf, to_copy * 2);
@@ -750,6 +780,16 @@ static int write_vmem(struct ili9488_par *par, size_t offset, size_t len)
     return 0;
 }
 
+/* set the address window and send lines start..end from src */
+static void send_lines(struct ili9488_par *par, const u8 *src,
+                       unsigned int start, unsigned int end)
+{
+    size_t len = (end - start + 1) * par->fbinfo->fix.line_length;
+
+    par->tftops->set_addr_win(par, 0, start, par->fbinfo->var.xres - 1, end);
+    write_mem(par, src, len);
+}
+
 static void update_display(struct ili9488_par *par, unsigned int start_line,
                            unsigned int end_line)
 {
@@ -779,21 +819,35 @@ static void update_display(struct ili9488_par *par, unsigned int start_line,
     /* for each column, refresh dirty rows */
 
     gpio_put(par->gpio.cs, 0);
-    par->tftops->set_addr_win(par, 0, start_line, par->fbinfo->var.xres - 1, end_line);
-
-    offset = start_line * par->fbinfo->fix.line_length;
-    len = (end_line - start_line + 1) * par->fbinfo->fix.line_length;
 
     if (p_3bit_mode)
     {
+        par->tftops->set_addr_win(par, 0, start_line, par->fbinfo->var.xres - 1, end_line);
+        offset = start_line * par->fbinfo->fix.line_length;
+        len = (end_line - start_line + 1) * par->fbinfo->fix.line_length;
         if (p_dither)
             write_vmem_3bit_dither(par, offset, len);
-	else
+        else
             write_vmem_3bit(par, offset, len);
     }
     else
     {
-        write_vmem(par, offset, len);
+        u32 ll = par->fbinfo->fix.line_length;
+
+        /* lines covered by the status bar overlay */
+        mutex_lock(&par->ovl_lock);
+        if (par->ovl_rows && start_line < par->ovl_rows) {
+            unsigned int oend = min(end_line, par->ovl_rows - 1);
+
+            send_lines(par, par->ovl_buf + start_line * ll, start_line, oend);
+            start_line = oend + 1;
+        }
+        mutex_unlock(&par->ovl_lock);
+
+        /* the rest from the framebuffer */
+        if (start_line <= end_line)
+            send_lines(par, (u8 *)par->fbinfo->screen_buffer + start_line * ll,
+                       start_line, end_line);
     }
 
     gpio_put(par->gpio.cs, 1);
@@ -909,6 +963,73 @@ static ssize_t ili9488_fb_write(struct fb_info *info, const char __user *buf,
     return 0;
 }
 
+/* ---- status bar overlay device (/dev/fb_overlay) ---- */
+
+static struct ili9488_par *ovl_par(struct file *f)
+{
+    return container_of(f->private_data, struct ili9488_par, ovl_misc);
+}
+
+static int ovl_open(struct inode *inode, struct file *f)
+{
+    struct ili9488_par *par = ovl_par(f);
+
+    if (atomic_cmpxchg(&par->ovl_open, 0, 1))
+        return -EBUSY;
+    return nonseekable_open(inode, f);
+}
+
+static ssize_t ovl_write(struct file *f, const char __user *buf,
+                         size_t count, loff_t *ppos)
+{
+    struct ili9488_par *par = ovl_par(f);
+    u32 ll = par->fbinfo->fix.line_length;
+    u32 rows, old;
+
+    if (p_3bit_mode)
+        return -EOPNOTSUPP;
+    if (count == 0 || count % ll || count / ll > OVL_MAX_ROWS)
+        return -EINVAL;
+    rows = count / ll;
+
+    mutex_lock(&par->ovl_lock);
+    if (copy_from_user(par->ovl_buf, buf, count)) {
+        mutex_unlock(&par->ovl_lock);
+        return -EFAULT;
+    }
+    old = par->ovl_rows;
+    par->ovl_rows = rows;
+    mutex_unlock(&par->ovl_lock);
+
+    ili9488_mkdirty(par->fbinfo, 0, max(rows, old));
+    return count;
+}
+
+static int ovl_release(struct inode *inode, struct file *f)
+{
+    struct ili9488_par *par = ovl_par(f);
+    u32 old;
+
+    mutex_lock(&par->ovl_lock);
+    old = par->ovl_rows;
+    par->ovl_rows = 0;
+    mutex_unlock(&par->ovl_lock);
+
+    /* show the framebuffer content again where the bar was */
+    if (old)
+        ili9488_mkdirty(par->fbinfo, 0, old);
+    atomic_set(&par->ovl_open, 0);
+    return 0;
+}
+
+static const struct file_operations ovl_fops = {
+    .owner   = THIS_MODULE,
+    .open    = ovl_open,
+    .write   = ovl_write,
+    .release = ovl_release,
+    .llseek  = no_llseek,
+};
+

+    if (p_hwswap)
+        return write_mem_hw16(par, src, len);
+
+    dev_dbg(par->dev, "%s, len = %d\n", __func__, len);
 
     remain = len / 2;
-    vmem16 = (u16 *)(par->fbinfo->screen_buffer + offset);
 

From 1496416253431c5b550cee66a5b9faf8d17c3085 Mon Sep 17 00:00:00 2001
From: LyraCalc OS <lyracalc-os@users.noreply.github.com>
Date: Thu, 22 Oct 2026 12:00:00 +0200
Subject: [PATCH 3/6] picocalc_snd_pwm: standby, soft fades, mute parameter

- output fades to 0 after idle_ms of silence and back up before playing
- glide back to the middle level after each sound
- timer is set up once; late timer calls skip samples
- runtime mute parameter
- keep the sound pin pulled low until the driver takes it over
---
 .../arm/boot/dts/rk3506-luckfox-lyra.dtsi     |  16 +
 .../drivers/picocalc/picocalc_snd_pwm.c       | 465 ++++++++++--------
 2 files changed, 283 insertions(+), 198 deletions(-)

diff --git a/kernel-6.1/arch/arm/boot/dts/rk3506-luckfox-lyra.dtsi b/kernel-6.1/arch/arm/boot/dts/rk3506-luckfox-lyra.dtsi
index 43964752..70328b98 100644
--- a/kernel-6.1/arch/arm/boot/dts/rk3506-luckfox-lyra.dtsi
+++ b/kernel-6.1/arch/arm/boot/dts/rk3506-luckfox-lyra.dtsi
@@ -1294,3 +1294,19 @@
 		};
 	};
 };
+
+/* PicoCalc: keep the sound pin (RMIO12 = GPIO0_B4) pulled low from early boot
+ * until the sound driver switches it to PWM -> no crackle while booting */
+&pinctrl {
+	picocalc_snd {
+		snd_idle: snd-idle {
+			rockchip,pins = <0 RK_PB4 RK_FUNC_GPIO &pcfg_pull_down>;
+		};
+	};
+};
+
+&pwm0_4ch_0 {
+	pinctrl-names = "default", "active";
+	pinctrl-0 = <&snd_idle>;
+	pinctrl-1 = <&rm_io12_pwm0_ch0>;
+};
diff --git a/kernel-6.1/drivers/picocalc/picocalc_snd_pwm.c b/kernel-6.1/drivers/picocalc/picocalc_snd_pwm.c

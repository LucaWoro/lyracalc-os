From 1b8d5e2db46d7372826c93b8c0704a28aa6dfe67 Mon Sep 17 00:00:00 2001
From: LyraCalc OS <lyracalc-os@users.noreply.github.com>
Date: Thu, 22 Oct 2026 12:00:00 +0200
Subject: [PATCH 2/6] picocalc_kbd: mouse keys, PICO-8 game mode, power off,
 stuck keys

- p_mouse=1: Shift+arrows move the pointer, Ctrl+[ / Ctrl+] click
- p_game: PICO-8 button layout, toggled with Alt+G while p_mouse=1
- sysfs power_off and p_off_delay: switch the PicoCalc off after shutdown
- release keys whose release event got lost
- Alt+O reports KEY_PROG1 (needs the matching STM32 firmware patch)
---
 kernel-6.1/drivers/picocalc/picocalc_kbd.c    | 298 +++++++++++++-----
 .../drivers/picocalc/picocalc_kbd_code.h      |   1 +
 2 files changed, 218 insertions(+), 81 deletions(-)

diff --git a/kernel-6.1/drivers/picocalc/picocalc_kbd.c b/kernel-6.1/drivers/picocalc/picocalc_kbd.c
index 6e6d01ab..9dade0de 100644
--- a/kernel-6.1/drivers/picocalc/picocalc_kbd.c
+++ b/kernel-6.1/drivers/picocalc/picocalc_kbd.c
@@ -9,6 +9,8 @@
 #include <linux/input.h>
 #include <linux/interrupt.h>
 #include <linux/i2c.h>
+#include <linux/reboot.h>
+#include <linux/delay.h>
 #include "picocalc_kbd_code.h"
 
 //#include "config.h"
@@ -18,6 +20,7 @@
 #define REG_ID_BKL (0x05)
 #define REG_ID_FIF (0x09)
 #define REG_ID_BK2 (0x0A)
+#define REG_ID_OFF (0x0E)
 
 #define PICOCALC_WRITE_MASK (1<<7)
 
@@ -37,6 +40,22 @@ static uint32_t sysfs_gid_setting = 0; // GID of files in /sys/firmware/picocalc
 
 static uint64_t mouse_fast_move_thr_time = 150000000ull;
 static int8_t mouse_move_step = 1;
+static int p_mouse = 0;
+module_param(p_mouse, int, 0644);
+static int p_off_delay = 0;
+module_param(p_off_delay, int, 0644);
+static int p_game = 0;
+module_param(p_game, int, 0644);
+MODULE_PARM_DESC(p_game, "PICO-8 game mode: [ = X, ] = O (only with p_mouse=1)");
+static int pico_alt_held;
+
+/* Stuck key protection: while a key is held, the firmware repeats its state
+ * about every 110 ms. If that stops without a release, release it ourselves. */
+#define PICO_STUCK_NS 500000000ULL
+static u64 pico_key_seen[256];
+static DECLARE_BITMAP(pico_key_down, 256);
+static int pico_g_down;
+static u64 pico_game_toggled_at;
 
 // From keyboard firmware source
 enum pico_key_state
@@ -77,6 +96,12 @@ struct kbd_ctx
         
         int mouse_mode;
         uint8_t mouse_move_dir;
+        uint8_t shift_held;
+        uint8_t shift_eaten;
+        uint8_t mouse_btns;
+        uint8_t ctrl_held;
+        uint8_t ctrl_eaten;
+        uint64_t mouse_start;
 };
 
 // Parse 0 to 255 from string
@@ -209,6 +234,26 @@ void input_fw_read_fifo(struct kbd_ctx* ctx)
 	}
 }
 
+static void pico_eat_shift(struct kbd_ctx *ctx)
+{
+	if (!ctx->shift_eaten) {
+		input_report_key(ctx->input_dev, KEY_LEFTSHIFT, 0);
+		input_report_key(ctx->input_dev, KEY_RIGHTSHIFT, 0);
+		input_sync(ctx->input_dev);
+		ctx->shift_eaten = 1;
+	}
+}
+
+static void pico_eat_ctrl(struct kbd_ctx *ctx)
+{
+	if (!ctx->ctrl_eaten) {
+		input_report_key(ctx->input_dev, KEY_LEFTCTRL, 0);
+		input_report_key(ctx->input_dev, KEY_RIGHTCTRL, 0);
+		input_sync(ctx->input_dev);
+		ctx->ctrl_eaten = 1;
+	}
+}
+
 static void key_report_event(struct kbd_ctx* ctx,
 	struct key_fifo_item const* ev)
 {
@@ -220,93 +265,89 @@ static void key_report_event(struct kbd_ctx* ctx,
 		return;
 	}
 
-        /* right shift */
-        if (ev->scancode == 0xA3)
+        if (ev->scancode == 0xA5)
         {
             if (ev->state == KEY_STATE_PRESSED)
+                ctx->ctrl_held = 1;
+            else if (ev->state == KEY_STATE_RELEASED)
             {
-                ctx->mouse_mode = !ctx->mouse_mode;
+                ctx->ctrl_held = 0;
+                if (ctx->ctrl_eaten)
+                {
+                    ctx->ctrl_eaten = 0;
+                    return;
+                }
             }
-            return;
+            if (ctx->ctrl_eaten)
+                return;
         }
 
-        if (ctx->mouse_mode)
+        if (ev->scancode == 0xA2 || ev->scancode == 0xA3)
         {
-            switch(ev->scancode)
+            uint8_t bit = (ev->scancode == 0xA2) ? 1 : 2;
+            if (ev->state == KEY_STATE_PRESSED)
+                ctx->shift_held |= bit;
+            else if (ev->state == KEY_STATE_RELEASED)
             {
-            /* KEY_BACKSPACE */
-/*
-            case '\b':
-                  if (ev->state == KEY_STATE_PRESSED)
-                  {
-                      input_report_abs(ctx->input_dev, ABS_X, 0);
-                      input_report_abs(ctx->input_dev, ABS_Y, 0);
-                  } 
-                  return;
-*/
-            /* KEY_RIGHT */
-            case 0xb7:
-                  if (ev->state == KEY_STATE_PRESSED)
-                  {
-                      if (!(ctx->mouse_move_dir & MOUSE_MOVE_RIGHT))
-	                  ctx->last_keypress_at = ktime_get_boottime_ns();
-                      ctx->mouse_move_dir |= MOUSE_MOVE_RIGHT;
-                  }
-                  else if (ev->state == KEY_STATE_RELEASED)
-                  {
-                      ctx->mouse_move_dir &= ~MOUSE_MOVE_RIGHT;
-                  }
-                  return;
-            /* KEY_LEFT */
-            case 0xb4:
-                  if (ev->state == KEY_STATE_PRESSED)
-                  {
-                      if (!(ctx->mouse_move_dir & MOUSE_MOVE_LEFT))
-	                  ctx->last_keypress_at = ktime_get_boottime_ns();
-                      ctx->mouse_move_dir |= MOUSE_MOVE_LEFT;
-                  }
-                  else if (ev->state == KEY_STATE_RELEASED)
-                  {
-	              ctx->last_keypress_at = ktime_get_boottime_ns();
-                      ctx->mouse_move_dir &= ~MOUSE_MOVE_LEFT;
-                  }
-                  return;
-            /* KEY_DOWN */
-            case 0xb6:
-                  if (ev->state == KEY_STATE_PRESSED)
-                  {
-                      if (!(ctx->mouse_move_dir & MOUSE_MOVE_DOWN))
-	                  ctx->last_keypress_at = ktime_get_boottime_ns();
-                      ctx->mouse_move_dir |= MOUSE_MOVE_DOWN;
-                  }
-                  else if (ev->state == KEY_STATE_RELEASED)
-                  {
-                      ctx->mouse_move_dir &= ~MOUSE_MOVE_DOWN;
-                  }
-                  return;
-            /* KEY_UP */
-            case 0xb5:
-                  if (ev->state == KEY_STATE_PRESSED)
-                  {
-                      if (!(ctx->mouse_move_dir & MOUSE_MOVE_UP))
-	                  ctx->last_keypress_at = ktime_get_boottime_ns();
-                      ctx->mouse_move_dir |= MOUSE_MOVE_UP;
-                  }
-                  else if (ev->state == KEY_STATE_RELEASED)
-                  {
-                      ctx->mouse_move_dir &= ~MOUSE_MOVE_UP;
-                  }
-                  return;
-            /* KEY_RIGHTBRACE */
-            case ']':
-	          input_report_key(ctx->input_dev, BTN_LEFT, ev->state == KEY_STATE_PRESSED);
-                  return;
-            /* KEY_LEFTBRACE */
-            case '[':
-	          input_report_key(ctx->input_dev, BTN_RIGHT, ev->state == KEY_STATE_PRESSED);
-                  return;
-            default:
-                     break;
+                ctx->shift_held &= ~bit;
+                if (!ctx->shift_held)
+                {
+                    ctx->mouse_move_dir = 0;
+                    ctx->shift_eaten = 0;
+                }
+            }
+            if (ctx->shift_eaten)
+                return;
+        }
+        else if (p_mouse || ctx->mouse_move_dir || ctx->mouse_btns)
+        {
+            uint8_t dir = 0, bbit = 0;
+            unsigned int btn = 0;
+            switch (ev->scancode)
+            {
+            case 0xb4: dir = MOUSE_MOVE_LEFT; break;
+            case 0xb7: dir = MOUSE_MOVE_RIGHT; break;
+            case 0xb5: case 0xd6: dir = MOUSE_MOVE_UP; break;
+            case 0xb6: case 0xd7: dir = MOUSE_MOVE_DOWN; break;
+            case ']': case '}': btn = BTN_LEFT; bbit = 1; break;
+            case '[': case '{': btn = BTN_RIGHT; bbit = 2; break;
+            default: break;
+            }
+            if (dir)
+            {
+                if (ev->state == KEY_STATE_PRESSED && ctx->shift_held && p_mouse)
+                {
+                    pico_eat_shift(ctx);
+                    if (!ctx->mouse_move_dir)
+                        ctx->mouse_start = ktime_get_boottime_ns();
+                    ctx->mouse_move_dir |= dir;
+                    return;
+                }
+                if (ctx->mouse_move_dir & dir)
+                {
+                    if (ev->state == KEY_STATE_RELEASED)
+                        ctx->mouse_move_dir &= ~dir;
+                    return;
+                }
+            }
+            if (btn)
+            {
+                if (ev->state == KEY_STATE_PRESSED && ctx->ctrl_held && p_mouse)
+                {
+                    pico_eat_ctrl(ctx);
+                    ctx->mouse_btns |= bbit;
+                    input_report_key(ctx->input_dev, btn, 1);
+                    return;
+                }
+                if (ctx->mouse_btns & bbit)
+                {
+                    if (ev->state == KEY_STATE_RELEASED)
+                    {
+                        ctx->mouse_btns &= ~bbit;
+                        input_report_key(ctx->input_dev, btn, 0);
+                    }
+                    return;
+                }
             }
         }
 
@@ -317,6 +358,45 @@ static void key_report_event(struct kbd_ctx* ctx,
 
 	keycode = keycodes[ev->scancode];
 
+	/* Alt+G toggles the PICO-8 game mode (only with p_mouse=1) */
+	if (ev->scancode == 0xA1) {
+		if (ev->state == KEY_STATE_PRESSED)
+			pico_alt_held = 1;
+		else if (ev->state == KEY_STATE_RELEASED)
+			pico_alt_held = 0;
+	}
+	if (ev->scancode == 'G' || ev->scancode == 'g') {
+		if (ev->state == KEY_STATE_RELEASED)
+			pico_g_down = 0;
+		if (p_mouse && pico_alt_held) {
+			u64 now = ktime_get_boottime_ns();
+
+			if (ev->state == KEY_STATE_PRESSED && !pico_g_down &&
+			    now - pico_game_toggled_at > 400000000ULL) {
+				p_game = !p_game;
+				pico_game_toggled_at = now;
+				dev_info(&ctx->i2c_client->dev, "PICO-8 game mode %s\n", p_game ? "on" : "off");
+			}
+			if (ev->state == KEY_STATE_PRESSED)
+				pico_g_down = 1;
+			return;
+		}
+	}
+
+	/* PICO-8 game mode: [ = X button, ] = O button; P, O, I and the default button keys are off */
+	if (p_mouse && p_game) {
+		switch (ev->scancode) {
+		case '[': case '{': keycode = KEY_X; break;
+		case ']': case '}': keycode = KEY_C; break;
+		case 'p': case 'P': case 'o': case 'O': case 'i': case 'I':
+		case 'x': case 'X': case 'c': case 'C': case 'z': case 'Z':
+		case 'v': case 'V': case 'n': case 'N': case 'm': case 'M': return;
+		default: break;
+		}
+		if (keycode == KEY_DELETE || keycode == KEY_END)
+			return;
+	}
+
 	//keycode = ev->scancode;
 	dev_info_fe(&ctx->i2c_client->dev,
 		"%s state %d, scancode %d mapped to keycode %d\n",
@@ -370,6 +450,9 @@ static void key_report_event(struct kbd_ctx* ctx,
 	}
     */
 
+	/* the firmware still reports this key: it is really held */
+	pico_key_seen[keycode] = ktime_get_boottime_ns();
+
 	// Ignore hold keys at this point
 	if (ev->state == KEY_STATE_HOLD) {
 		return;
@@ -382,6 +465,10 @@ static void key_report_event(struct kbd_ctx* ctx,
 
 	// Report key to input system
 	input_report_key(ctx->input_dev, keycode, ev->state == KEY_STATE_PRESSED);
+	if (ev->state == KEY_STATE_PRESSED)
+		set_bit(keycode, pico_key_down);
+	else
+		clear_bit(keycode, pico_key_down);
 
 	// Reset sticky modifiers
 //	input_modifiers_reset(ctx);
@@ -401,9 +488,26 @@ static void input_workqueue_handler(struct work_struct *work_struct_ptr)
 		key_report_event(ctx, &ctx->key_fifo_data[fifo_idx]);
 	}
 
-	if (ctx->mouse_mode)
+	/* release keys whose release event got lost */
+	{
+		u64 now = ktime_get_boottime_ns();
+		unsigned int k;
+		bool released = false;
+
+		for_each_set_bit(k, pico_key_down, 256) {
+			if (now - pico_key_seen[k] > PICO_STUCK_NS) {
+				clear_bit(k, pico_key_down);
+				input_report_key(ctx->input_dev, k, 0);
+				released = true;
+			}
+		}
+		if (released)
+			input_sync(ctx->input_dev);
+	}
+
+	if (ctx->mouse_move_dir)
         {
-            uint64_t press_time = ktime_get_boottime_ns() - ctx->last_keypress_at;
+            uint64_t press_time = ktime_get_boottime_ns() - ctx->mouse_start;
             if (press_time <= mouse_fast_move_thr_time)
             {
                 mouse_move_step = 1;
@@ -696,6 +800,19 @@ static ssize_t last_keypress_show(struct kobject *kobj, struct kobj_attribute *a
 struct kobj_attribute last_keypress_attr
 	= __ATTR(last_keypress, 0444, last_keypress_show, NULL);
 
+static ssize_t __used power_off_store(struct kobject *kobj,
+	struct kobj_attribute *attr, char const *buf, size_t count)
+{
+	int sec = parse_u8(buf);
+	if (sec < 0)
+		return -EINVAL;
+	if (g_ctx && g_ctx->i2c_client)
+		kbd_write_i2c_u8(g_ctx->i2c_client, REG_ID_OFF, 0x80 | (sec & 0x3F));
+	return count;
+}
+struct kobj_attribute power_off_attr
+	= __ATTR(power_off, 0220, NULL, power_off_store);
+
 // Sysfs attributes (entries)
 struct kobject *picocalc_kobj = NULL;
 static struct attribute *picocalc_attrs[] = {
@@ -703,6 +820,7 @@ static struct attribute *picocalc_attrs[] = {
 	&screen_backlight_attr.attr,
 	&last_keypress_attr.attr,
 	&keyboard_backlight_attr.attr,
+	&power_off_attr.attr,
 	NULL,
 };
 static struct attribute_group picocalc_attr_group = {
@@ -760,6 +878,21 @@ void sysfs_shutdown(struct i2c_client* i2c_client)
 	}
 }
 
+static int picocalc_reboot_notify(struct notifier_block *nb, unsigned long code, void *unused)
+{
+	if (p_off_delay > 0 && (code == SYS_POWER_OFF || code == SYS_HALT) && g_ctx && g_ctx->i2c_client) {
+		del_timer_sync(&g_kbd_timer);
+		cancel_work_sync(&g_ctx->work_struct);
+		pr_emerg("picocalc: PicoCalc powers off in %d s\n", p_off_delay);
+		kbd_write_i2c_u8(g_ctx->i2c_client, REG_ID_OFF, 0x80 | (p_off_delay & 0x3F));
+		mdelay(100);
+	}
+	return NOTIFY_DONE;
+}
+static struct notifier_block picocalc_reboot_nb = {
+	.notifier_call = picocalc_reboot_notify,
+};
+
 static int picocalc_kbd_probe
 #if LINUX_VERSION_CODE < KERNEL_VERSION(6, 6, 0)
 (struct i2c_client* i2c_client, struct i2c_device_id const* i2c_id)
@@ -786,6 +919,8 @@ static int picocalc_kbd_probe
 		return rc;
 	}
 
+	register_reboot_notifier(&picocalc_reboot_nb);
+
 	return 0;
 }
 
@@ -798,6 +933,7 @@ static void picocalc_kbd_shutdown(struct i2c_client* i2c_client)
 
 static void picocalc_kbd_remove(struct i2c_client* i2c_client)
 {
+	unregister_reboot_notifier(&picocalc_reboot_nb);
 	dev_info_fe(&i2c_client->dev,
 		"%s Removing picocalc-kbd.\n", __func__);
 
diff --git a/kernel-6.1/drivers/picocalc/picocalc_kbd_code.h b/kernel-6.1/drivers/picocalc/picocalc_kbd_code.h
index 8a63ba57..354da475 100644
--- a/kernel-6.1/drivers/picocalc/picocalc_kbd_code.h
+++ b/kernel-6.1/drivers/picocalc/picocalc_kbd_code.h
@@ -201,6 +201,7 @@ static unsigned short keycodes[NUM_KEYCODES] = {
 	[0xb4] = KEY_LEFT,
 	[0xd6] = KEY_PAGEUP,
 	[0xd7] = KEY_PAGEDOWN,
+	[0xE1] = KEY_PROG1,
 };
 
 

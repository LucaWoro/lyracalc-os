+/* TIC80_NOBORDER=1: show only the 240x136 picture, without the coloured border (small screens) */
+static bool noBorder(void)
+{
+    static s32 value = -1;
+    if(value < 0)
+    {
+        const char* env = getenv("TIC80_NOBORDER");
+        value = env && *env && *env != '0';
+    }
+    return value;
+}
